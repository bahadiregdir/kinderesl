# KinderESL Environment Variables

# Site Base URL (Defaults to https://kinderesl.com if empty)
# Set to https://kinderesl.vercel.app during initial staging if desired
NEXT_PUBLIC_SITE_URL=https://kinderesl.com

# 301 Permanent Redirect Guard
# Set to 'true' in Vercel ONLY AFTER kinderesl.com is purchased and DNS is active
# While 'false' (default), vercel.app is directly accessible for previewing with X-Robots-Tag: noindex
ENABLE_DOMAIN_REDIRECT=false

# Contact Email (Defaults to [BURAYA GERÇEK E-POSTA] if empty)
# Set to your real inbox email (e.g. yourname@gmail.com or hello@kinderesl.com)
NEXT_PUBLIC_CONTACT_EMAIL=[BURAYA GERÇEK E-POSTA]

# Google AdSense Publisher ID (Leave empty or unset until approved)
# Example: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google Analytics 4 Measurement ID (Optional, leave empty until ready)
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Pinterest Domain Verification Token (Leave empty until account is set up)
NEXT_PUBLIC_PINTEREST_VERIFICATION=

# Admin Studio Authentication (REQUIRED in production!)
# Set a strong password in Vercel Environment Variables to unlock /admin in live deployment.
ADMIN_PASSWORD=

# Optional dedicated HMAC secret for admin session cookies (falls back to ADMIN_PASSWORD if unset)
ADMIN_SESSION_SECRET=

# Neon Postgres Database (Recommended for dynamic CMS & analytics)
DATABASE_URL=

# Cloudflare R2 Object Storage (Recommended for zero-egress PDFs & previews)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kinderesl-assets
R2_PUBLIC_URL=https://cdn.kinderesl.com

# Hybrid Git-CMS Configuration (Fallback only when DB/R2 are not configured)
# Create a fine-grained GitHub PAT with Contents: Read & Write permission on bahadiregdir/kinderesl
GITHUB_TOKEN=
GITHUB_REPO=bahadiregdir/kinderesl
GITHUB_BRANCH=main
